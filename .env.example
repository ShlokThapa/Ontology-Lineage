# ---- Lineage Studio configuration -------------------------------------------
# live     = connect to Neo4j (default)
# snapshot = offline: lineage pages read data/nodes.json + data/edges.json
MODE=live

# Neo4j AuraDB connection (credentials stay on the server)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Comma-separated list of browser origins allowed to call the API (dev: Vite on :5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hard limit on rows returned by a user query
MAX_ROWS=1000
# Transaction timeout for user queries
QUERY_TIMEOUT_SECONDS=30

# ---- Chatbot (Azure OpenAI) -------------------------------------------------
# Key / endpoint / deployment of your Azure OpenAI resource. AZURE_OPEN_AI_MODEL_NAME is the deployment name.
AZURE_OPEN_AI_KEY=change-me
AZURE_OPEN_AI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPEN_AI_MODEL_NAME=your-deployment-name
AZURE_OPEN_AI_VERSION=2024-12-01-preview

# Optional extra deployments for the policy-mapping job. Leave them empty and model 1 does every role.
# Add them if model 1's token limit bites: 2 then verifies the mapper's links, 3 breaks ties.
# Endpoint / key / version reuse the first model's unless you set AZURE_OPEN_AI_ENDPOINT_2, _KEY_2, _VERSION_2 (and _3).
AZURE_OPEN_AI_MODEL_NAME_2=
AZURE_OPEN_AI_MODEL_NAME_3=

# ---- Run jobs page: trigger Fabric notebooks and pipelines ---------------------------------------------
# The workspace: an id, or a name that is looked up (the project's workspace is called Ontology_Lineage).
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=Ontology_Lineage
# Sign in as a service principal (add it to the workspace as Contributor or higher) ...
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
# ... or paste a bearer token for a quick try (it expires, usually within the hour).
FABRIC_ACCESS_TOKEN=
# false = every button that would write to Neo4j (run with write, accept / reject, undo) refuses.
MAPPING_UI_WRITE=true
